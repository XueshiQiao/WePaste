{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "WePaste",
  "version": "0.1.0",
  "identifier": "me.xueshi.wepaste",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WePaste",
        "width": 440,
        "height": 620,
        "minWidth": 390,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0N0RGQUE5MjUxRDM5RDYKUldUV09SMGxxZnA5bEc2VkdWcG5Dam5NYlFZdHZMZmJuOVFvODZ0aDN0Ny9wcEdHVHhEbTFuQlMK",
      "endpoints": [
        "https://github.com/XueshiQiao/WePaste/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
